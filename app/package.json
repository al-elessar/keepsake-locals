{
  "name": "keepsake-locals-app",
  "productName": "Keepsake",
  "version": "0.1.0",
  "description": "Keepsake – Downloader for Locals (unofficial desktop app). Not affiliated with Locals or Rumble.",
  "author": "Elessar (al-elessar)",
  "license": "MIT",
  "homepage": "https://github.com/al-elessar/keepsake-locals",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "sync": "node ../scripts/sync-core.js",
    "prestart": "npm run sync",
    "start": "electron .",
    "predist": "npm run sync",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run sync && electron-builder --dir --publish never",
    "test": "node test/run-unit.js",
    "test:e2e": "node test/e2e.js"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.56.0"
  },
  "build": {
    "appId": "com.al-elessar.keepsake",
    "productName": "Keepsake",
    "copyright": "Copyright © 2026 al-elessar. MIT licence.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Keepsake-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Keepsake",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video",
      "artifactName": "Keepsake-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "artifactName": "Keepsake-${version}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/al-elessar/keepsake-locals.git",
    "directory": "app"
  }
}
